# Sensitive variables file for Packer build
# This file should be kept secure and not committed to version control
# Proxmox connection details
proxmox_api_url          = "https://<proxmox_server>:8006/api2/json"
proxmox_api_token_id     = "<token_id>"
proxmox_api_token_secret = "<token_secret>"

# SSH key authentication for the template
ssh_private_key_file = "<path_to_private_key>"
ssh_public_key       = "<public_key>"